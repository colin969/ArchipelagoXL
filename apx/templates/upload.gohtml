{{template "base" .}}

{{define "title"}}Upload Room{{end}}

{{define "header-row"}}
<div class="breadcrumb">
  <span class="nav__link nav__link--active">Upload Room</span>
</div>
{{end}}

{{define "content"}}
<h1 class="page__title">Create Room</h1>

{{if .Error}}
<div class="flash flash--error">{{.Error}}</div>
{{end}}

<div class="card">
  <div class="card__title">Upload Multidata</div>
  <form id="upload-form" enctype="multipart/form-data">
    <div class="form-row">
      <label for="file">Multidata File / Zip</label>
      <input type="file" id="file" name="file" accept=".archipelago,.zip" required>
    </div>

    <div class="form-check">
      <input type="checkbox" id="deathlink_disabled" name="deathlink_disabled" value="true">
      <label for="deathlink_disabled">Disable DeathLink</label>
    </div>

    <div class="form-check">
      <input type="checkbox" id="per_slot_passwords" name="per_slot_passwords" value="true">
      <label for="per_slot_passwords">Per-slot Passwords</label>
    </div>

    <div class="form-check">
      <input type="checkbox" id="reduced_access" name="reduced_access" value="true">
      <label for="reduced_access">Reduced Access</label>
    </div>

    <div id="upload-flash"></div>

    <button type="submit" class="btn btn--confirm" id="submit-btn">Upload &amp; Create Room</button>
  </form>
</div>
{{end}}

{{define "scripts"}}
<script>
document.getElementById("upload-form").addEventListener("submit", async function(e) {
  e.preventDefault();

  const btn       = document.getElementById("submit-btn");
  const flashEl   = document.getElementById("upload-flash");
  const form      = e.target;
  const formData  = new FormData(form);

  for (const name of ["deathlink_disabled", "per_slot_passwords", "reduced_access"]) {
    const el = form.elements[name];
    if (!el.checked) {
      formData.set(name, "false");
    }
  }

  btn.disabled    = true;
  btn.textContent = "Uploading...";
  flashEl.innerHTML = "";

  try {
    const res = await fetch("/api/room", {
      method: "POST",
      body: formData,
    });

    const json = await res.json();

    if (!res.ok) {
      flashEl.innerHTML = `<div class="flash flash--error" style="margin-top:1rem">${json.error ?? "Unknown error"}</div>`;
      return;
    }

    // Redirect to the room dashboard
    window.location.href = `/dashboard/${json.lobby_room_id}`;
  } catch (err) {
    flashEl.innerHTML = `<div class="flash flash--error" style="margin-top:1rem">Request failed: ${err}</div>`;
  } finally {
    btn.disabled    = false;
    btn.textContent = "Upload & Create Room";
  }
});
</script>
{{end}}
