{{template "base" .}}

{{define "title"}}Upload Room{{end}}

{{define "content"}}
<h1 class="page__title">Upload Room</h1>

{{if .Error}}
<div class="flash flash--error">{{.Error}}</div>
{{end}}
{{if .Success}}
<div class="flash flash--success">{{.Success}}</div>
{{end}}

<form method="POST" action="/admin/upload" enctype="multipart/form-data" id="upload-form">

    <div class="card">
        <div class="card__title">Multidata File</div>

        <div class="form-row">
            <label for="file">File <span style="color:#a22020">*</span></label>
            <input type="file" id="file" name="file" accept=".archipelago,.zip" required>
            <span class="form-hint">Accepts .archipelago or .zip containing an .archipelago file.</span>
        </div>

        <div class="form-row">
            <label for="lobby_room_id">Lobby Room ID</label>
            <input type="text" id="lobby_room_id" name="lobby_room_id"
                   placeholder="Leave blank to auto-generate"
                   value="{{.FormValues.LobbyRoomId}}">
            <span class="form-hint">24-character alphanumeric ID. Auto-generated if empty.</span>
        </div>
    </div>

    <div class="card">
        <div class="card__title">Room Options</div>

        <label class="form-check">
            <input type="checkbox" name="per_slot_passwords"
                   {{if .FormValues.PerSlotPasswords}}checked{{end}}>
            Per-slot passwords
            <span class="form-hint" style="margin:0 0 0 0.25rem">(fetched from lobby on start)</span>
        </label>

        <label class="form-check">
            <input type="checkbox" name="deathlink_disabled"
                   {{if .FormValues.DeathlinkDisabled}}checked{{end}}>
            Disable DeathLink
        </label>

        <label class="form-check">
            <input type="checkbox" name="reduced_access"
                   {{if .FormValues.ReducedAccess}}checked{{end}}>
            Reduced access
            <span class="form-hint" style="margin:0 0 0 0.25rem">(full-feed opt-in per slot)</span>
        </label>
    </div>

    <button type="submit" class="btn btn--confirm" id="submit-btn">
        Upload &amp; Start Room
    </button>

</form>
{{end}}

{{define "scripts"}}
<script>
(function () {
    const form = document.getElementById('upload-form');
    const btn  = document.getElementById('submit-btn');

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        btn.disabled = true;
        btn.textContent = 'Uploading…';

        try {
            const formData = new FormData(form);
            const resp = await fetch('/admin/upload', {
                method: 'POST',
                // No Content-Type header — browser sets multipart boundary automatically
                body: formData,
            });

            if (resp.redirected) {
                window.location.href = resp.url;
                return;
            }

            if (!resp.ok) {
                const text = await resp.text();
                // Server returned an error page — replace body to show it
                document.open();
                document.write(text);
                document.close();
                return;
            }

            window.location.href = '/admin/rooms';
        } catch (err) {
            btn.disabled = false;
            btn.textContent = 'Upload & Start Room';
            alert(`Upload failed: ${err}`);
        }
    });
})();
</script>
{{end}}
