{{template "base" .}}

{{define "title"}} Tracker - {{.RoomId}}{{end}}

{{define "header-row"}}
<div class="breadcrumb">
  <a class="nav__link" href="/dashboard/{{.RoomId}}">Room</a>
  <span class="nav__sep">›</span>
  <a class="nav__link nav__link--active" href="/dashboard/{{.RoomId}}/tracker">Tracker</a>
</div>
<div id="interval-header"></div>
{{end}}


{{define "content"}}

<h1>Dashboard</h1>

<div className="overview-wrapper">
  <div className="table-topper">
  </div>
  <div className="table-container">
    <div id="tracker-table"></div>
  </div>
</div>

{{end}}
{{define "styles"}}
<style>
  .tabulator {
    font-size: 16px;
  }
  .tabulator-selectable {
    cursor: unset !important;
  }
  .player-id-link {
    font-weight: bold;
    color: lightblue;
    cursor: pointer;
  }
</style>
{{end}}
{{define "scripts"}}
<script>
const ROOM_ID = {{.RoomId}};

let table = null
let rowCache = {};

function epochToRelative(epoch) {
  if (!epoch) return "Never";
  const diffSecs = Math.floor(Date.now() / 1000) - epoch;
  if (diffSecs < 60)  return `${diffSecs}s ago`;
  const mins = Math.floor(diffSecs / 60);
  if (mins < 60)      return `${mins}m ago`;
  const hrs  = Math.floor(mins / 60);
  const rem  = mins % 60;
  return rem > 0 ? `${hrs}h ${rem}m ago` : `${hrs}h ago`;
}

function refreshActivityTimes() {
  if (!table) return;
  for (const [id, cached] of Object.entries(rowCache)) {
    const row = table.getRow(Number(id));
    if (row) row.update({
      lastActivity:   epochToRelative(cached._rawActivity),
      lastConnection: epochToRelative(cached._rawConnection),
    });
  }
}

function setupTable(playersJson, firstPatch) {
  let tableData = []
  const patchDict = {}
  for (const patch of firstPatch) {
    patchDict[patch["s"]] = patch
  }
  for (const player of playersJson) {
    const patchPlayer = patchDict[player["slot"]]
    const checked   = patchPlayer["c"];
    const totalLocs = patchPlayer["l"];
    tableData.push({
      id: player["slot"],
      name: player["name"],
      game: player["game"],
      totalLocs: patchPlayer["l"],
      checked: patchPlayer["c"],
      percent: totalLocs > 0 ? checked / totalLocs : 0,
      status: patchPlayer["st"],
      lastActivity:   epochToRelative(patchPlayer["a"]),
      lastConnection: epochToRelative(patchPlayer["lc"]),
      _rawActivity:    patchPlayer["a"],
      _rawConnection:  patchPlayer["lc"],
    })
  }

  for (const row of tableData) {
    rowCache[row.id] = row;
  }

  const checksFormatter = function(cell) {
    const row     = cell.getRow().getData();
    const checked = row.checked;
    const total   = row.totalLocs;
    return `${checked} / ${total}`;
  };

  const checksCalc = function(values, data) {
    let totalChecked   = 0;
    let totalLocations = 0;
    for (const row of data) {
      totalChecked   += row.checked   ?? 0;
      totalLocations += row.totalLocs ?? 0;
    }
    return [totalChecked, totalLocations];
  };

  const checksCalcFormatter = function(cell) {
    const [checked, total] = cell.getValue();
    return `${checked} / ${total}`;
  };

  const checksSorter = function(a, b, aRow, bRow) {
    return (aRow.getData().totalLocs ?? 0) - (bRow.getData().totalLocs ?? 0);
  };

  const percentFormatter = function(cell) {
    const pct    = cell.getValue() * 100;
    const label  = pct.toFixed(1);
    return label;
  };

  const percentCalc = function(values, data) {
    let totalChecked = 0
    let totalLocations = 0;
    for (const row of data) {
      totalChecked   += row.checked;
      totalLocations += row.totalLocs;
    }
    return totalLocations > 0 ? totalChecked / totalLocations : 0;
  };

  const percentCalcFormatter = function(cell) {
    return (cell.getValue() * 100).toFixed(1) + "%";
  };

  const idFormatter = function(cell) {
    const id = cell.getValue();
    return `<div class="player-id-link">${id}</div>`;
  };

  const onClickId = function(event, cell) {
    const id = cell.getValue();
    window.location.href = `/dashboard/${ROOM_ID}/tracker/0/${id}`;
  }

  table.setColumns([
    {title: "ID", field: "id", width: 60, formatter: idFormatter, cellClick: onClickId},
    {title: "Name", field: "name"},
    {title: "Game", field: "game"},
    {title: "Checks", hozAlign: "center", width: 180, field: "checked", sorter: checksSorter, formatter: checksFormatter, bottomCalc: checksCalc, bottomCalcFormatter: checksCalcFormatter},
    {title: "% Complete", width: 140, hozAlign: "center", field: "percent", sorter: "number", formatter: percentFormatter, bottomCalc: percentCalc, bottomCalcFormatter: percentCalcFormatter},
    {title: "Last Activity", width: 240, hozAlign: "center", field: "lastActivity"},
  ])
  table.setData(tableData);
}

function updateTable(newPatch) {
  if (table === null) return;

  for (const player of newPatch) {
    const id        = player["s"];
    const checked   = player["c"] ?? 0;
    const totalLocs = player["l"] ?? 0;

    if (!rowCache[id]) continue;

    // Update cache
    rowCache[id].checked        = checked;
    rowCache[id].totalLocs      = totalLocs;
    rowCache[id].percent        = totalLocs > 0 ? checked / totalLocs : 0;
    rowCache[id].status         = player["st"];
    rowCache[id].lastActivity   = epochToRelative(player["a"]);
    rowCache[id].lastConnection = epochToRelative(player["lc"]);
    rowCache[id]._rawActivity   = player["a"];
    rowCache[id]._rawConnection = player["lc"];

    // Update only that row in the DOM
    const row = table.getRow(id);
    if (row) row.update(rowCache[id]);
  }
}

function initLoadingTable() {
  table = new Tabulator("#tracker-table", {
    maxHeight: "80vh",
    layout: "fitColumns",
    rowHeight: 32,
    placeholder: `<div class="loading-placeholder">
                    <div class="loading-spinner"></div>
                    Loading...
                  </div>`,
    columns: [
      {title: "ID", field: "id", width: 60},
      {title: "Name", field: "name"},
      {title: "Game", field: "game"},
      {title: "Checks", hozAlign: "center", width: 180, field: "checked"},
      {title: "% Complete", width: 140, hozAlign: "center", field: "percent"},
      {title: "Last Activity", width: 240, hozAlign: "center", field: "lastActivity"},
    ],
  });
}

async function initialLoad() {
  console.log("Doing initial load");

  let pingInterval;
  let activityTicker;

  const playersUrl = `/api/tracker/${ROOM_ID}/players`;
  const liveUrl = `/api/tracker/${ROOM_ID}/live`;

  // Get players info
  const playersRes = await fetch(playersUrl);
  if (!playersRes.ok) {
    alert("Failed to get players list :(");
    return;
  }
  const playersJson = await playersRes.json();

  // Get initial live connection
  const websocket = new WebSocket(liveUrl);

  websocket.addEventListener("error", () => {
  
  })

  websocket.addEventListener("open", () => {
    console.log("Connected to live feed");
    pingInterval = setInterval(() => websocket.send("#"), 10_000);
    activityTicker = setInterval(refreshActivityTimes, 60_000);
  });

  websocket.addEventListener("close", () => {
    console.log("DISCONNECTED");
    clearInterval(pingInterval);
    clearInterval(activityTicker);
  });

  websocket.addEventListener("message", (e) => {
    const parsed = JSON.parse(e.data)
    const event  = parsed["event"];

    if (event === "interval") {
        const seconds = Math.round(parsed["ms"] / 1000);
        document.getElementById("interval-header").textContent = `Updates every ${seconds}s`;
    } else if (event === "snapshot") {
        setupTable(playersJson, parsed["data"]["player_state"]);
    } else if (event === "patch") {
        updateTable(parsed["data"]);
    }
  });
}

initLoadingTable();
initialLoad();
</script>
{{end}}