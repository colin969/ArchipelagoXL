<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Room Tracker - {{.RoomID}}</title>
    <link href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator_midnight.min.css" rel="stylesheet">
    <style>
        body {
            font-family: monospace;
            background: #1a1a1a;
            color: #e0e0e0;
            padding: 20px;
        }
        h1 { color: #aaa; font-size: 1.2em; margin-bottom: 16px; }
        #status { font-size: 0.8em; color: #666; margin-bottom: 12px; }
        #status.connected { color: #4caf50; }
        #status.disconnected { color: #f44336; }
        #tracker-table { margin-top: 8px; }
        .bar-wrap {
            flex: 1;
            background: #333;
            border-radius: 2px;
            height: 6px;
            min-width: 80px;
            display: inline-block;
            vertical-align: middle;
        }
        .bar {
            height: 6px;
            border-radius: 2px;
            background: #4caf50;
            transition: width 0.3s ease;
        }
        .bar.complete { background: #2196f3; }
        .bar-label { color: #aaa; margin-left: 8px; font-size: 0.85em; }
        .status-badge {
            font-size: 0.75em;
            padding: 2px 6px;
            border-radius: 3px;
            background: #333;
        }
        .status-0 { color: #666; }
        .status-5 { color: #4caf50; background: #1b3a1f; }
        .status-20 { color: #2196f3; background: #0d2a3a; }
        .status-30 { color: #ff9800; background: #3a2800; }
    </style>
</head>
<body>
    <h1>{{.RoomID}} — Player Tracker</h1>
    <div id="status">Connecting...</div>
    <div id="tracker-table"></div>

    <script src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>
    <script>
        const ROOM_ID = {{.RoomID | js}};
        const API_BASE = "/api";

        const slotMeta = {};
        const slotState = {};

        const statusEl = document.getElementById("status");

        function statusLabel(s) {
            switch (s) {
                case 0:  return { text: "Unknown",   cls: "status-0" };
                case 5:  return { text: "Connected", cls: "status-5" };
                case 20: return { text: "Ready",     cls: "status-5" };
                case 30: return { text: "Goal",      cls: "status-20" };
                default: return { text: `State ${s}`, cls: "status-0" };
            }
        }

        function fmtTime(iso) {
            if (!iso) return "—";
            const d = new Date(iso);
            const diff = Math.floor((Date.now() - d) / 1000);
            if (diff < 60)   return `${diff}s ago`;
            if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
            return `${Math.floor(diff / 3600)}h ago`;
        }

        const table = new Tabulator("#tracker-table", {
            data: [],
            index: "slot",
            layout: "fitColumns",
            height: "80vh",
            virtualDom: true,
            initialSort: [{ column: "name", dir: "asc" }],
            columns: [
                { title: "Slot",  field: "slot",  width: 70 },
                { title: "Player", field: "name", widthGrow: 2 },
                {
                    title: "Progress",
                    field: "checks",
                    widthGrow: 3,
                    formatter: (cell) => {
                        const row = cell.getRow().getData();
                        const checks = row.checks || 0;
                        const total  = row.locs || slotMeta[row.slot]?.total_locs || 0;
                        const pct    = total > 0 ? Math.round((checks / total) * 100) : 0;
                        const complete = checks >= total && total > 0;
                        return `
                            <div style="display:flex;align-items:center;gap:8px">
                                <div class="bar-wrap" style="width:100%">
                                    <div class="bar ${complete ? 'complete' : ''}" style="width:${pct}%"></div>
                                </div>
                                <span class="bar-label">${checks} / ${total}</span>
                            </div>`;
                    },
                    sorter: (a, b, ar, br) => {
                        const pctA = ar.getData().locs > 0 ? ar.getData().checks / ar.getData().locs : 0;
                        const pctB = br.getData().locs > 0 ? br.getData().checks / br.getData().locs : 0;
                        return pctA - pctB;
                    },
                },
                {
                    title: "State",
                    field: "status",
                    width: 110,
                    formatter: (cell) => {
                        const sl = statusLabel(cell.getValue() || 0);
                        return `<span class="status-badge ${sl.cls}">${sl.text}</span>`;
                    },
                },
                {
                    title: "Last Active",
                    field: "last_activity",
                    width: 120,
                    formatter: (cell) => fmtTime(cell.getValue()),
                    sorter: (a, b) => new Date(a || 0) - new Date(b || 0),
                },
            ],
        });

        function rowData(slot, state) {
            return {
                slot,
                name: slotMeta[slot]?.name || `Slot ${slot}`,
                checks: state.c || 0,
                locs:   state.l || slotMeta[slot]?.total_locs || 0,
                status: state.st || 0,
                last_activity: state.a || null,
            };
        }

        function applySnapshot(players) {
            players.forEach(p => { slotState[p.s] = p; });
            const rows = players.map(p => rowData(p.s, p));
            table.replaceData(rows);
        }

        function applyPatch(players) {
            players.forEach(p => {
                if (!slotState[p.s]) return;
                Object.assign(slotState[p.s], p);
                table.updateData([rowData(p.s, slotState[p.s])]);
            });
        }

        async function loadStatic() {
            try {
                const res  = await fetch(`${API_BASE}/static_tracker/${ROOM_ID}`);
                const data = await res.json();
                (data.player_game || []).forEach(p => {
                    slotMeta[p.player] = { name: null, game: p.game };
                });
                (data.player_location_total || []).forEach(p => {
                    if (slotMeta[p.player]) slotMeta[p.player].total_locs = p.total_locations;
                });
            } catch (e) {
                console.warn("failed to load static tracker data", e);
            }

            try {
                const res     = await fetch(`${API_BASE}/tracker/${ROOM_ID}/players`);
                const players = await res.json();
                players.forEach(p => {
                    if (slotMeta[p.slot]) {
                        slotMeta[p.slot].name = p.name;
                    } else {
                        slotMeta[p.slot] = { name: p.name, game: p.game };
                    }
                });
            } catch (e) {
                console.warn("failed to load player names", e);
            }

            connectWS();
        }

        function connectWS() {
            let backoff = 1000;

            function connect() {
                const proto = location.protocol === "https:" ? "wss:" : "ws:";
                const ws = new WebSocket(`${proto}//${location.host}${API_BASE}/tracker/${ROOM_ID}/live`);

                ws.onopen = () => {
                    backoff = 1000;
                    statusEl.textContent = "● Live";
                    statusEl.className = "connected";
                };

                ws.onmessage = (e) => {
                    const msg = JSON.parse(e.data);
                    if (msg.event === "snapshot") {
                        applySnapshot(msg.data.player_state);
                    } else if (msg.event === "patch") {
                        applyPatch(msg.data);
                    }
                };

                ws.onclose = () => {
                    statusEl.textContent = `○ Disconnected — reconnecting in ${Math.round(backoff / 1000)}s...`;
                    statusEl.className = "disconnected";
                    setTimeout(connect, backoff);
                    backoff = Math.min(backoff * 2, 30000);
                };

                ws.onerror = () => {
                    ws.close();
                };
            }

            connect();
        }

        setInterval(() => {
            table.getRows().forEach(row => {
                row.getCell("last_activity").refreshValue();
            });
        }, 30000);

        loadStatic();
    </script>
</body>
</html>
